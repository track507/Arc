{
	"name": "arc",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "An engine that runs a fillable PDF character sheet and its own scripts in the browser",
	"license": "Apache-2.0",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=26.12.1",
		"pnpm": ">=12.16.1"
	},
	"scripts": {
		"boundaries": "depcruise packages tools --config .dependency-cruiser.mjs",
		"check": "pnpm run format:check && pnpm run lint && pnpm run lint:md && pnpm run typecheck && pnpm run boundaries && pnpm run test && pnpm run names",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:md": "markdownlint-cli2 \"**/*.md\"",
		"names": "node tools/gate/src/cli.ts",
		"prepare": "lefthook install",
		"setup:engine": "node engine/scripts/setup.ts",
		"test": "vitest run",
		"typecheck": "tsc -p . && pnpm -r typecheck"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@commitlint/types": "21.2.3",
		"@eslint/js": "10.0.1",
		"dependency-cruiser": "18.7.0",
		"eslint": "10.13.0",
		"eslint-plugin-sonarjs": "4.2.2",
		"globals": "17.13.0",
		"lefthook": "2.2.2",
		"markdownlint-cli2": "0.24.0",
		"prettier": "3.9.10",
		"typescript": "catalog:",
		"typescript-eslint": "8.72.0",
		"vitest": "catalog:"
	}
}
