root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,mts,js,mjs,json,jsonc}]
indent_style = tab
indent_size = 4
max_line_length = 160

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 4
max_line_length = off

[engine/quickjs/**]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
max_line_length = unset

# ! A patch's find and replace are C text that must match the release byte for byte, trailing spaces included
[engine/patches/*.ts]
trim_trailing_whitespace = false

# ? quickjs-ng's license notice ships as quickjs-ng wrote it
[engine/patches/LICENSE-quickjs-ng]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
